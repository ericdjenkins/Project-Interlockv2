@import "tailwindcss";

:root {
  --navy-950: #020b1d;
  --navy-900: #061632;
  --navy-800: #08224d;
  --blue: #1478ff;
  --blue-light: #43b5ff;
  --gold: #ffc528;
  --gold-soft: #ffe07a;
  --cream: #f5f1e8;
  --white: #ffffff;
  --ink: #071329;
  --muted: #526077;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: var(--font-geist-sans), Arial, Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

img {
  display: block;
  max-width: 100%;
}

.siteHeader {
  align-items: center;
  background: rgba(2, 11, 29, 0.96);
  border-bottom: 1px solid rgba(255, 255, 255, 0.11);
  display: grid;
  grid-template-columns: minmax(210px, 1fr) auto minmax(210px, 1fr);
  height: 92px;
  padding: 0 clamp(24px, 4vw, 68px);
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 20;
}

.brand {
  display: block;
  width: clamp(190px, 18vw, 250px);
}

.desktopNav {
  align-items: center;
  display: flex;
  gap: clamp(22px, 2.5vw, 40px);
}

.desktopNav a {
  color: rgba(255, 255, 255, 0.82);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  padding: 10px 0;
  position: relative;
  text-transform: uppercase;
}

.desktopNav a::after {
  background: var(--gold);
  bottom: 3px;
  content: "";
  height: 2px;
  left: 0;
  position: absolute;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 180ms ease;
  width: 100%;
}

.desktopNav a:hover::after,
.desktopNav a:focus-visible::after {
  transform: scaleX(1);
}

.desktopCta {
  justify-self: end;
}

.button {
  align-items: center;
  border: 1px solid transparent;
  display: inline-flex;
  font-size: 12px;
  font-weight: 800;
  gap: 18px;
  justify-content: center;
  letter-spacing: 0.1em;
  min-height: 58px;
  padding: 0 28px;
  text-transform: uppercase;
  transition:
    transform 180ms ease,
    background 180ms ease,
    color 180ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button:focus-visible,
a:focus-visible,
summary:focus-visible {
  outline: 3px solid var(--blue-light);
  outline-offset: 4px;
}

.buttonSmall {
  min-height: 44px;
  padding: 0 20px;
}

.buttonGold {
  background: var(--gold);
  color: var(--navy-950);
}

.buttonGold:hover {
  background: var(--gold-soft);
}

.mobileMenu {
  display: none;
}

.hero {
  background: var(--navy-950);
  color: var(--white);
  min-height: 820px;
  overflow: hidden;
  padding: 190px clamp(24px, 7vw, 112px) 120px;
  position: relative;
}

.heroImage {
  height: 100%;
  inset: 0;
  object-fit: cover;
  object-position: 60% center;
  position: absolute;
  width: 100%;
}

.heroShade {
  background:
    linear-gradient(90deg, rgba(2, 11, 29, 0.98) 0%, rgba(2, 11, 29, 0.92) 34%, rgba(2, 11, 29, 0.48) 67%, rgba(2, 11, 29, 0.15) 100%),
    linear-gradient(0deg, rgba(2, 11, 29, 0.85) 0%, transparent 42%);
  inset: 0;
  position: absolute;
}

.hero::after {
  background: linear-gradient(90deg, var(--blue), var(--gold));
  bottom: 0;
  content: "";
  height: 6px;
  left: 0;
  position: absolute;
  width: 100%;
}

.network {
  border: 1px solid rgba(67, 181, 255, 0.22);
  border-radius: 50%;
  height: 340px;
  position: absolute;
  right: -120px;
  top: 130px;
  width: 340px;
}

.network::before,
.network::after {
  border: 1px solid rgba(255, 197, 40, 0.3);
  border-radius: 50%;
  content: "";
  inset: 42px;
  position: absolute;
}

.network::after {
  inset: 110px;
}

.networkTwo {
  bottom: -180px;
  height: 420px;
  left: 42%;
  right: auto;
  top: auto;
  width: 420px;
}

.heroContent {
  max-width: 760px;
  position: relative;
  z-index: 2;
}

.kicker,
.eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

.kicker {
  color: rgba(255, 255, 255, 0.78);
  margin: 0 0 30px;
}

.kicker span {
  color: var(--gold);
  margin: 0 8px;
}

.hero h1 {
  font-size: clamp(58px, 6.6vw, 108px);
  letter-spacing: -0.065em;
  line-height: 0.91;
  margin: 0;
  max-width: 880px;
}

.hero h1 span {
  color: var(--gold);
  display: block;
}

.heroLead {
  color: rgba(255, 255, 255, 0.82);
  font-size: clamp(16px, 1.4vw, 20px);
  line-height: 1.65;
  margin: 34px 0 38px;
  max-width: 650px;
}

.heroActions {
  align-items: center;
  display: flex;
  gap: 30px;
}

.textLink {
  border-bottom: 1px solid rgba(255, 255, 255, 0.45);
  color: var(--white);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 10px 0;
  text-transform: uppercase;
}

.textLink span {
  color: var(--gold);
  margin-left: 10px;
}

.heroSignal {
  bottom: 42px;
  position: absolute;
  right: clamp(24px, 5vw, 80px);
  z-index: 3;
}

.signalLabel {
  color: rgba(255, 255, 255, 0.55);
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  margin-bottom: 11px;
  text-align: right;
  text-transform: uppercase;
}

.signalItems {
  align-items: center;
  display: flex;
  gap: 11px;
}

.signalItems span {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.signalItems i {
  background: var(--gold);
  border-radius: 50%;
  height: 5px;
  width: 5px;
}

.statement,
.pathwaySection {
  display: grid;
  gap: clamp(40px, 8vw, 150px);
  grid-template-columns: 180px 1fr;
  padding: clamp(90px, 11vw, 170px) clamp(24px, 7vw, 112px);
}

.sectionLabel {
  align-self: start;
  align-items: center;
  display: flex;
  gap: 14px;
}

.sectionLabel span {
  align-items: center;
  border: 1px solid rgba(7, 19, 41, 0.22);
  border-radius: 50%;
  display: flex;
  font-size: 10px;
  font-weight: 800;
  height: 36px;
  justify-content: center;
  width: 36px;
}

.sectionLabel p {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.15em;
  margin: 0;
  text-transform: uppercase;
}

.sectionLabel.light span {
  border-color: rgba(255, 255, 255, 0.26);
}

.statementBody {
  max-width: 1020px;
}

.statementIntro {
  color: var(--muted);
  font-size: clamp(25px, 3vw, 44px);
  letter-spacing: -0.03em;
  line-height: 1.2;
  margin: 0;
}

.statement h2,
.programIntro h2,
.pathwayHeader h2,
.involvementHeader h2,
.closingCta h2 {
  font-size: clamp(48px, 6vw, 88px);
  letter-spacing: -0.06em;
  line-height: 0.94;
  margin: 8px 0 0;
}

.statement h2 {
  color: var(--blue);
}

.missionGrid {
  border-top: 1px solid rgba(7, 19, 41, 0.16);
  display: grid;
  gap: 60px;
  grid-template-columns: 1fr 1fr;
  margin-top: 60px;
  padding-top: 32px;
}

.missionGrid p {
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
  margin: 0;
}

.programSection {
  background: var(--navy-900);
  color: var(--white);
  padding: clamp(90px, 10vw, 150px) clamp(24px, 7vw, 112px);
}

.programIntro {
  align-items: end;
  display: grid;
  gap: 50px;
  grid-template-columns: 180px minmax(460px, 1fr) minmax(260px, 390px);
  margin-bottom: 70px;
}

.programIntro .sectionLabel {
  align-self: start;
}

.programIntro .eyebrow,
.involvementHeader .eyebrow {
  color: var(--gold);
  margin: 0 0 20px;
}

.programIntro h2 {
  margin: 0;
}

.programSummary {
  color: rgba(255, 255, 255, 0.68);
  font-size: 15px;
  line-height: 1.8;
  margin: 0;
}

.programList {
  border-top: 1px solid rgba(255, 255, 255, 0.16);
}

.programCard {
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  display: grid;
  gap: 36px;
  grid-template-columns: 70px minmax(240px, 0.8fr) minmax(320px, 1.2fr) 50px;
  min-height: 160px;
  padding: 28px 12px;
  transition:
    background 200ms ease,
    padding 200ms ease;
}

.programCard:hover {
  background: rgba(20, 120, 255, 0.12);
  padding-left: 24px;
  padding-right: 24px;
}

.programNumber {
  color: var(--gold);
  font-size: 12px;
  font-weight: 800;
}

.programTitle span {
  color: var(--blue-light);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.programTitle h3 {
  font-size: clamp(25px, 2.6vw, 38px);
  letter-spacing: -0.04em;
  margin: 7px 0 0;
}

.programCard > p {
  color: rgba(255, 255, 255, 0.66);
  font-size: 15px;
  line-height: 1.7;
  margin: 0;
}

.programArrow {
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  height: 42px;
  justify-content: center;
  justify-self: end;
  transition:
    background 180ms ease,
    color 180ms ease;
  width: 42px;
}

.programCard:hover .programArrow {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--navy-950);
}

.pathwaySection {
  background: var(--white);
  grid-template-columns: 180px 1fr;
}

.pathwayHeader {
  max-width: 900px;
}

.pathwayHeader .eyebrow {
  color: var(--blue);
  margin: 0 0 18px;
}

.pathwayHeader h2 {
  margin: 0;
}

.pathwayHeader h2 span {
  color: var(--blue);
}

.pathwayTrack {
  display: grid;
  gap: 0;
  grid-column: 2;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 35px;
  position: relative;
}

.pathwayTrack::before {
  background: linear-gradient(90deg, var(--blue), var(--gold));
  content: "";
  height: 2px;
  left: 18px;
  position: absolute;
  right: 18px;
  top: 18px;
}

.pathwayStep {
  padding-right: clamp(18px, 3vw, 48px);
  position: relative;
}

.stepMarker {
  align-items: center;
  background: var(--white);
  border: 2px solid var(--blue);
  border-radius: 50%;
  display: flex;
  height: 38px;
  justify-content: center;
  position: relative;
  width: 38px;
  z-index: 2;
}

.pathwayStep:last-child .stepMarker {
  background: var(--gold);
  border-color: var(--gold);
}

.stepMarker span {
  font-size: 10px;
  font-weight: 900;
}

.stepName {
  color: var(--blue) !important;
  font-size: 10px !important;
  font-weight: 800;
  letter-spacing: 0.16em;
  margin: 35px 0 12px !important;
  text-transform: uppercase;
}

.pathwayStep h3 {
  font-size: clamp(21px, 2vw, 28px);
  letter-spacing: -0.04em;
  margin: 0 0 16px;
}

.pathwayStep > p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
  margin: 0;
}

.beliefSection {
  align-items: start;
  background: var(--gold);
  display: grid;
  gap: 50px;
  grid-template-columns: 80px 1fr 120px;
  padding: clamp(80px, 9vw, 140px) clamp(24px, 9vw, 150px);
}

.beliefMark {
  color: var(--navy-900);
  font-family: Georgia, serif;
  font-size: 130px;
  line-height: 0.65;
}

.beliefSection blockquote {
  font-size: clamp(35px, 5vw, 72px);
  font-weight: 700;
  letter-spacing: -0.055em;
  line-height: 1.04;
  margin: 0;
  max-width: 1050px;
}

.beliefSection blockquote span {
  color: rgba(6, 22, 50, 0.65);
  display: block;
}

.beliefTag {
  align-items: center;
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 8px;
}

.beliefTag span {
  background: var(--navy-900);
  display: block;
  height: 2px;
  width: 30px;
}

.beliefTag p {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.15em;
  margin: 0;
  text-transform: uppercase;
}

.involvementSection {
  background: var(--navy-950);
  color: var(--white);
  padding: clamp(90px, 10vw, 150px) clamp(24px, 7vw, 112px);
}

.involvementHeader {
  display: grid;
  gap: 46px;
  grid-template-columns: 180px 1fr minmax(260px, 380px);
  margin-bottom: 68px;
}

.involvementHeader h2 {
  margin: 0;
}

.involvementHeader h2 span {
  color: var(--gold);
  display: block;
}

.involvementHeader > p {
  align-self: end;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.8;
  margin: 0;
}

.involvementGrid {
  display: grid;
  gap: 1px;
  grid-template-columns: repeat(3, 1fr);
}

.involvementCard {
  background: var(--navy-900);
  min-height: 470px;
  padding: clamp(30px, 4vw, 58px);
  padding-bottom: 112px;
  position: relative;
  transition:
    background 220ms ease,
    transform 220ms ease;
}

.involvementCard:nth-child(2) {
  background: var(--navy-800);
}

.involvementCard:hover {
  background: #0d2d62;
  transform: translateY(-8px);
  z-index: 2;
}

.cardIndex {
  color: rgba(255, 255, 255, 0.28);
  font-size: 12px;
  font-weight: 800;
  position: absolute;
  right: 30px;
  top: 28px;
}

.involvementCard .eyebrow {
  color: var(--blue-light);
  margin: 0 0 50px;
}

.involvementCard h3 {
  font-size: clamp(29px, 3vw, 44px);
  letter-spacing: -0.045em;
  margin: 0 0 24px;
}

.involvementCard > p:not(.eyebrow) {
  color: rgba(255, 255, 255, 0.64);
  font-size: 15px;
  line-height: 1.75;
  margin: 0;
}

.involvementCard a {
  border-bottom: 2px solid var(--gold);
  bottom: 44px;
  color: var(--white);
  font-size: 11px;
  font-weight: 800;
  left: clamp(30px, 4vw, 58px);
  letter-spacing: 0.1em;
  padding-bottom: 9px;
  position: absolute;
  text-transform: uppercase;
}

.involvementCard a span {
  color: var(--gold);
  margin-left: 10px;
}

.closingCta {
  align-items: center;
  background: var(--blue);
  color: var(--white);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: clamp(90px, 11vw, 170px) 24px;
  position: relative;
  text-align: center;
}

.closingGlow {
  background: rgba(255, 197, 40, 0.85);
  border-radius: 50%;
  filter: blur(90px);
  height: 280px;
  position: absolute;
  right: -80px;
  top: -130px;
  width: 280px;
}

.closingCta .eyebrow {
  margin: 0 0 24px;
  position: relative;
}

.closingCta h2 {
  margin: 0 0 42px;
  position: relative;
}

.closingCta h2 span {
  color: var(--navy-950);
}

.closingCta .button {
  position: relative;
}

footer {
  background: var(--navy-950);
  color: var(--white);
  display: grid;
  gap: 60px;
  grid-template-columns: 1.3fr 1fr;
  padding: 75px clamp(24px, 7vw, 112px) 35px;
}

.footerBrand img {
  width: min(420px, 88%);
}

.footerBrand > p {
  color: rgba(255, 255, 255, 0.58);
  line-height: 1.7;
  margin: 28px 0 0;
  max-width: 430px;
}

.footerLinks {
  display: grid;
  gap: 30px;
  grid-template-columns: repeat(2, 1fr);
  justify-self: end;
  width: min(420px, 100%);
}

.footerLinks div {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.footerLinks p {
  color: var(--gold);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  margin: 0 0 10px;
  text-transform: uppercase;
}

.footerLinks a {
  color: rgba(255, 255, 255, 0.72);
  font-size: 14px;
}

.footerLinks a:hover {
  color: var(--white);
}

.footerBottom {
  align-items: center;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  grid-column: 1 / -1;
  justify-content: space-between;
  padding-top: 30px;
}

.footerBottom p,
.footerBottom a {
  color: rgba(255, 255, 255, 0.48);
  font-size: 11px;
  letter-spacing: 0.04em;
  margin: 0;
}

@media (max-width: 1050px) {
  .siteHeader {
    grid-template-columns: 1fr auto;
  }

  .desktopNav,
  .desktopCta {
    display: none;
  }

  .mobileMenu {
    display: block;
    justify-self: end;
    position: relative;
  }

  .mobileMenu summary {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    list-style: none;
    padding: 12px;
  }

  .mobileMenu summary::-webkit-details-marker {
    display: none;
  }

  .mobileMenu summary span {
    background: var(--white);
    display: block;
    height: 2px;
    width: 26px;
  }

  .mobileMenu nav {
    background: var(--navy-900);
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-direction: column;
    min-width: 220px;
    padding: 16px;
    position: absolute;
    right: 0;
    top: 52px;
  }

  .mobileMenu nav a {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 15px 12px;
    text-transform: uppercase;
  }

  .programIntro,
  .involvementHeader {
    grid-template-columns: 1fr 2fr;
  }

  .programIntro > :last-child,
  .involvementHeader > :last-child {
    grid-column: 2;
  }

  .programCard {
    grid-template-columns: 50px minmax(220px, 0.8fr) 1.2fr 50px;
  }

  .pathwayTrack {
    gap: 34px;
    grid-template-columns: 1fr 1fr;
  }

  .pathwayTrack::before {
    display: none;
  }
}

@media (max-width: 760px) {
  .siteHeader {
    height: 76px;
    padding: 0 18px;
  }

  .brand {
    width: 190px;
  }

  .hero {
    min-height: 760px;
    padding: 145px 24px 125px;
  }

  .heroImage {
    object-position: 67% center;
  }

  .heroShade {
    background:
      linear-gradient(90deg, rgba(2, 11, 29, 0.97), rgba(2, 11, 29, 0.48)),
      linear-gradient(0deg, rgba(2, 11, 29, 0.95), rgba(2, 11, 29, 0.12) 65%);
  }

  .hero h1 {
    font-size: clamp(50px, 14vw, 72px);
  }

  .heroLead {
    font-size: 16px;
    line-height: 1.55;
  }

  .heroActions {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .heroSignal {
    bottom: 35px;
    left: 24px;
    right: auto;
  }

  .signalLabel {
    text-align: left;
  }

  .statement,
  .pathwaySection {
    display: block;
    padding: 85px 24px;
  }

  .sectionLabel {
    margin-bottom: 48px;
  }

  .missionGrid {
    gap: 24px;
    grid-template-columns: 1fr;
    margin-top: 42px;
  }

  .programSection,
  .involvementSection {
    padding: 85px 24px;
  }

  .programIntro,
  .involvementHeader {
    display: block;
    margin-bottom: 50px;
  }

  .programIntro .sectionLabel,
  .involvementHeader .sectionLabel {
    margin-bottom: 50px;
  }

  .programIntro h2,
  .involvementHeader h2 {
    font-size: 48px;
  }

  .programSummary,
  .involvementHeader > p {
    margin-top: 28px;
  }

  .programCard {
    align-items: start;
    gap: 10px;
    grid-template-columns: 38px 1fr 42px;
    padding: 30px 0;
  }

  .programCard:hover {
    padding-left: 12px;
    padding-right: 12px;
  }

  .programCard > p {
    grid-column: 2 / 4;
    margin-top: 8px;
  }

  .programArrow {
    grid-column: 3;
    grid-row: 1;
  }

  .pathwayTrack {
    display: grid;
    gap: 42px;
    grid-column: auto;
    grid-template-columns: 1fr;
    margin-top: 55px;
  }

  .pathwayStep {
    border-left: 2px solid rgba(20, 120, 255, 0.25);
    padding: 0 0 0 34px;
  }

  .stepMarker {
    left: -54px;
    position: absolute;
    top: 0;
  }

  .stepName {
    margin-top: 0 !important;
  }

  .beliefSection {
    display: block;
    padding: 75px 24px;
  }

  .beliefMark {
    font-size: 90px;
    height: 48px;
  }

  .beliefSection blockquote {
    font-size: 39px;
  }

  .beliefTag {
    justify-content: flex-start;
    margin-top: 42px;
  }

  .involvementGrid {
    grid-template-columns: 1fr;
  }

  .involvementCard {
    min-height: 430px;
  }

  .closingCta h2 {
    font-size: 48px;
  }

  footer {
    grid-template-columns: 1fr;
    padding: 60px 24px 30px;
  }

  .footerLinks {
    justify-self: start;
  }

  .footerBottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
